# ---------------------------------------------------------------------
# Variables d'environnement — Hangzhou BYGL Global Trading Company
# ---------------------------------------------------------------------
# Copiez ce fichier en ".env" (développement local avec `vercel dev`)
# et renseignez vos propres valeurs. Ne JAMAIS commiter le fichier ".env"
# réel dans Git — il est déjà exclu par .gitignore.
#
# Pour obtenir ces valeurs, suivez le README.md, sections "Gmail API"
# et "OAuth 2.0", qui expliquent pas à pas :
#   1. la création du projet Google Cloud
#   2. l'activation de l'API Gmail
#   3. la création des identifiants OAuth (Client ID / Client Secret)
#   4. l'obtention du refresh token
# ---------------------------------------------------------------------

# Identifiant client OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=

# Secret client OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_SECRET=

# Refresh token obtenu après autorisation OAuth de votre compte Gmail
GOOGLE_REFRESH_TOKEN=

# Adresse Gmail qui envoie ET reçoit les demandes du formulaire
# (ex. contact.bygl@gmail.com)
GMAIL_USER=
